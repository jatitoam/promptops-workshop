# Bloque 1 — Google AI Studio: crea la key en https://aistudio.google.com/apikey
# OJO: muchas cuentas institucionales no pueden crear keys. Usa una cuenta personal de Gmail.
GOOGLE_GENERATIVE_AI_API_KEY=

# Bloque 4 — Langfuse: crea tu propio proyecto en Langfuse Cloud → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Bloque 4 — Langfuse: el host de la región de tu proyecto.
# El nombre de esta variable importa: el SDK de JavaScript lee LANGFUSE_BASE_URL.
# LANGFUSE_HOST es el nombre del SDK de Python y aquí NO funciona — con ese nombre
# el cliente se va al host por defecto (región UE) y responde 401 "Invalid
# credentials", que parece un problema de keys y no lo es.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Bloque 6 — Groq: crea la key en https://console.groq.com/keys
# Esta key se pega en DOS lugares: aquí, y dentro de Langfuse
# (Settings → LLM Connections) para configurar el juez openai/gpt-oss-120b.
GROQ_API_KEY=
