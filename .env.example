# Bloque 1 — Google AI Studio: crea la key en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Bloque 6 — Groq: crea la key en https://console.groq.com/keys
# IMPORTANTE: esta misma key también se pega DENTRO de Langfuse (Settings → Models/LLM
# Connections) para configurar el juez openai/gpt-oss-120b — no solo aquí en el .env.
GROQ_API_KEY=

# Bloque 4 — Langfuse: crea tu propio proyecto en Langfuse Cloud → Settings → API Keys
LANGFUSE_PUBLIC_KEY=

# Bloque 4 — Langfuse: la secret key del mismo proyecto (Settings → API Keys)
LANGFUSE_SECRET_KEY=

# Bloque 4 — Langfuse: host de la región de tu proyecto (normalmente no hace falta cambiarlo)
LANGFUSE_HOST=https://us.cloud.langfuse.com
